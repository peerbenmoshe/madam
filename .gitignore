# Secrets: never committed
.env
.env.*
!.env.example
# Written into the checkout by google-github-actions/auth in CI's deploy job.
gha-creds-*.json

# Dependencies and build output
node_modules/
frontend/dist/
# The frontend build copied in for go:embed. The empty placeholder stays
# committed so the package compiles on a fresh clone. Git can't re-include a
# file inside an ignored directory, hence "/*" rather than the directory.
backend/internal/web/assets/*
!backend/internal/web/assets/.gitkeep
/bin/
coverage/
*.out

# Local tool settings
.claude/settings.local.json
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Screenshots from the browser checks (deploy/browser-check/run.sh).
deploy/browser-check/screenshots/
