# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# The Makefile reads this file (`-include .env`), so use plain KEY=value lines:
# no quotes, no `export`, and no `$` in values.
#
# Don't set DATABASE_URL here. The Makefile sets it from DB=local|dev.

# Port the API listens on locally. Cloud Run sets its own.
PORT=8080

# madam-dev Supabase project, two session pooler connection strings (port
# 5432; the laptop has no IPv6, so not the direct connection). Used only with
# `make <target> DB=dev`. Both end in ?sslmode=verify-full: the app refuses to
# connect to a remote database without verifying its certificate
# (docs/tech-stack.md §5). Production URLs never go in this file.
#
# The owner, for migrations and `make psql`: user postgres.<project-ref>,
# copied from the dashboard (Connect -> Session pooler).
MADAM_DEV_MIGRATE_URL=
# The application role, for the app, the tests and `make psql-app`: the same
# URL with the user madam_app.<project-ref> and madam_app's own password.
MADAM_DEV_DATABASE_URL=

# madam-dev's address, https://<project-ref>.supabase.co (dashboard: Project
# Settings -> Data API -> Project URL). The server accepts only tokens signed
# by this project's Auth. Used with DB=local too: the local container has no
# Auth. Not a secret. Production's is in the Makefile.
MADAM_DEV_SUPABASE_URL=

# Optional, and normally left out: the sign-up hook's invite code and
# signing secret. The Makefile has throwaway defaults, enough for the server
# to start. Set them only when madam-dev's "before user created" hook points
# at this machine (through a tunnel): the secret is then the dashboard's
# "v1,whsec_..." value. Production's are in Secret Manager.
# INVITE_CODE=
# AUTH_HOOK_SECRET=
