# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# The Makefile reads this file (`-include .env`), so use plain KEY=value lines:
# no quotes, no `export`, and no `$` in values.
#
# Don't set DATABASE_URL here. The Makefile sets it from DB=local|dev.

# Port the API listens on locally. Cloud Run sets its own.
PORT=8080

# madam-dev Supabase project, session pooler connection string (port 5432; the
# laptop has no IPv6, so not the direct connection). From the Supabase
# dashboard: Connect -> Session pooler. Used only with `make <target> DB=dev`.
# The production URL never goes in this file.
MADAM_DEV_DATABASE_URL=
